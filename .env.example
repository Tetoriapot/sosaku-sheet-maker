# Node.js 24+. Copy this file to .env; keep it out of version control.
SHARE_STORAGE=sqlite
SQLITE_PATH=.data/shares.sqlite
API_HOST=127.0.0.1
API_PORT=8787
DEV_PORT=5174

# For deployment, set your actual HTTPS origin (no trailing path).
# PUBLIC_ORIGIN=https://your-domain.example
# ALLOWED_ORIGINS=https://your-domain.example
# API_HOST=0.0.0.0

# Apply supabase/migrations/202610020001_shares.sql first, then switch storage.
# SHARE_STORAGE=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=your-server-only-secret-key
# New sb_secret_* or legacy service_role keys are supported.
# Never prefix a secret key with VITE_.
